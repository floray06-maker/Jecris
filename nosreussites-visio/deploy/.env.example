# Copier ce fichier en .env puis compléter.
# Les clés se génèrent avec ./generer-cles.sh

# Adresse de l'application (ce que les participants tapent dans leur navigateur)
APP_DOMAIN=visio.nosreussites.org
# Adresse technique du serveur vidéo
LIVEKIT_DOMAIN=rtc.nosreussites.org
# Adresse électronique pour les certificats HTTPS (avis d'expiration de Let's Encrypt)
ACME_EMAIL=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
